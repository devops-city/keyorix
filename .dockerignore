# Build context for server/Dockerfile, cmd/keyorix-k8s-sync/Dockerfile, and
# cmd/keyorix-mcp/Dockerfile — all three build from repo-root context `.` and
# `COPY . .`, so this excludes anything none of them need (#115): without it,
# the full .git history, docs, and dev-only tooling all get sent to the builder
# and are then reachable by any build step that runs after `COPY . .`.
#
# Keep: go.mod, go.sum, go.work*, main.go, server/, cmd/, internal/ — shared by
# all three image builds.

.git
.github
.claude
.task

# Docs, examples, and non-build directories.
docs/
demo/
examples/
migrations/
integrations/
scripts/
deploy/
# configs/ is excluded EXCEPT the embedded default config template that
# server/admin/init.go compiles in (configs.DefaultConfigTemplate); excluding the
# whole directory broke `docker build -f server/Dockerfile .`. Every non-test Go
# file there must be listed: deploy TestDockerignoreKeepsEveryFileTheServerCompiles.
configs/*
!configs/embed.go
!configs/dev_template.go
!configs/keyorix.yaml.tpl
operator/

# Prose / metadata files, not needed to build a binary.
*.md
LICENSE
LICENSING.md
COPYRIGHT
BACKLOG.md

# Dev-only tooling and local-only configs.
.env.example
.env
.env.*
.pre-commit-config.yaml
.golangci.yml
.gitleaks.toml
.gitattributes
revive.toml
Taskfile.yml
buf.yaml
buf.gen.yaml
docker-compose.yml
Caddyfile
keyorix.docker.yaml
push-all.sh
install.sh

# web/ IS needed now (#2752): server/Dockerfile's webui stage builds the dashboard from
# it so the server binary embeds the real SPA. Its build INPUTS are needed; its local
# build OUTPUTS and installed dependencies are not, and must not be sent -- node_modules
# is large, host-arch-specific, and would be copied straight over the webui stage's own
# `pnpm install --frozen-lockfile` result; a stale local web/dist would be rebuilt by
# `pnpm build` anyway.
**/node_modules
web/dist
web/test-results
web/playwright-report
web/coverage

# Never send local secrets/keys into a build context.
*.key
*.pem
dek.key*
kek.salt*
