# Caddy front-end for the hosted demo (DEMO-HOSTED-1); mounted over the root
# Caddyfile by docker-compose.demo.yml.
#
# - Automatic Let's Encrypt certificate for the hostname given at install
#   (KEYORIX_DOMAIN). Ports 80 and 443 must reach this VM and DNS must point here.
#   Rehearse with KEYORIX_ACME_CA set to the staging directory (install.sh
#   --acme-staging): production Let's Encrypt rate-limits repeated failures.
# - The gate (basic auth and/or an IP allow-list) lives in gate.caddy, generated by
#   install.sh. It is imported by exact name: if the file is missing Caddy refuses to
#   start, so a broken install fails closed instead of serving the demo to everyone.
# - route {} keeps the written order: gate first, then the proxy.
# - The access log (JSON, stdout) is what `keyorix-demo idle-check` reads. Caddy
#   redacts Authorization and Cookie headers in it by default.
# - The web container already sends the CSP and the cross-origin headers; here only
#   what a TLS terminator owns.
{
	email {$KEYORIX_ACME_EMAIL}
	acme_ca {$KEYORIX_ACME_CA}
	admin off
}

{$KEYORIX_DOMAIN} {
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	route {
		import /etc/caddy/gate/gate.caddy
		reverse_proxy web:80
	}
}
