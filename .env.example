# Keyorix self-hosted stack — copy to .env and fill in. NEVER commit .env.
#
# Generate strong values, e.g.:
#   openssl rand -base64 32

# PostgreSQL password (used by both the postgres and backend services). REQUIRED.
KEYORIX_DB_PASSWORD=

# Master passphrase the encryption KEK is derived from. REQUIRED.
# ⚠️  Back this up securely and NEVER change it after first boot — changing it (or
# losing the `keyorix_keys` volume) makes every stored secret undecryptable.
KEYORIX_MASTER_PASSWORD=

# First-boot admin bootstrap (optional). If KEYORIX_ADMIN_PASSWORD is set, the
# server creates this admin on first start (idempotent). Leave blank to initialise
# manually with `keyorix system init`.
# KEYORIX_BOOTSTRAP_TOKEN is REQUIRED alongside KEYORIX_ADMIN_PASSWORD: /system/init
# always requires a matching bootstrap token, and the server has no way to hand you
# back the token it would otherwise generate randomly on its own. Set both, or
# neither — setting KEYORIX_ADMIN_PASSWORD without KEYORIX_BOOTSTRAP_TOKEN silently
# skips admin creation (a WARN is logged, but the container still reports healthy).
# Generate one with: openssl rand -base64 32
KEYORIX_ADMIN_USERNAME=admin
KEYORIX_ADMIN_EMAIL=admin@keyorix.local
KEYORIX_ADMIN_PASSWORD=
KEYORIX_BOOTSTRAP_TOKEN=

# TLS (only used by the `tls` compose profile: docker compose --profile tls up).
# Set to your real domain (with ports 80/443 reachable + DNS pointing here) for an
# automatic, publicly-trusted certificate. Leave as localhost for Caddy's internal
# CA (browser trust warning).
KEYORIX_DOMAIN=localhost

# HSTS behind your own TLS-terminating load balancer (not needed with the `tls`
# profile, where Caddy sends HSTS itself). The web nginx sends
# Strict-Transport-Security only for requests from these proxies (IPs/CIDRs,
# comma-separated; the address nginx sees as the peer) that say
# X-Forwarded-Proto=https. Empty = no proxy trusted = no HSTS. Keep it equal to the
# backend's server.http.trusted_proxies. See docs/SELF_HOSTING.md.
KEYORIX_WEB_TRUSTED_PROXIES=
# auto (on when trusted proxies are set) | on | off
KEYORIX_WEB_HSTS=auto
