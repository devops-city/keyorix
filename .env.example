# Keyorix self-hosted stack — copy to .env. NEVER commit .env.
#
# Credentials are NOT set here. They are Docker secrets files under ./secrets,
# created by:
#
#   ./scripts/selfhost/init-secrets.sh                  # new install
#   ./scripts/selfhost/init-secrets.sh --from-env .env  # upgrade from an .env that
#                                                       # still holds the passwords
#
# which also appends KEYORIX_SECRETS_GID below. See docs/SELF_HOSTING.md §3.
#
# ⚠️  Back up ./secrets/master_password securely and NEVER change it after first
# boot — changing it (or losing the `keyorix_keys` volume) makes every stored
# secret undecryptable.

# First-boot admin (the password is ./secrets/admin_password).
KEYORIX_ADMIN_USERNAME=admin
KEYORIX_ADMIN_EMAIL=admin@keyorix.local

# Where the secrets files live (default ./secrets).
# KEYORIX_SECRETS_DIR=./secrets

# TLS (only used by the `tls` compose profile: docker compose --profile tls up).
# Set to your real domain (with ports 80/443 reachable + DNS pointing here) for an
# automatic, publicly-trusted certificate. Leave as localhost for Caddy's internal
# CA (browser trust warning).
KEYORIX_DOMAIN=localhost

# HSTS behind your own TLS-terminating load balancer (not needed with the `tls`
# profile, where Caddy sends HSTS itself). The web nginx sends
# Strict-Transport-Security only for requests from these proxies (IPs/CIDRs,
# comma-separated; the address nginx sees as the peer) that say
# X-Forwarded-Proto=https. Empty = no proxy trusted = no HSTS. Keep it equal to the
# backend's server.http.trusted_proxies. See docs/SELF_HOSTING.md.
KEYORIX_WEB_TRUSTED_PROXIES=
# auto (on when trusted proxies are set) | on | off
KEYORIX_WEB_HSTS=auto
